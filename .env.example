# Copy this file to .env and adjust as needed for local docker compose runs.
# Nothing in this file is a secret - it only documents the configurable
# knobs the app exposes. Real secrets belong in a Kubernetes Secret, not
# in an env file that could be committed.

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API. "*" is fine
# for local development; scope this down in real deployments.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Frontend (build-time) ---
# Where the browser should send API requests. Leave empty for same-origin.
VITE_API_URL=http://localhost:8000
